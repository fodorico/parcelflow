# Copy to .env and fill in. Never commit .env.
# Empty values fall back to the defaults in app/config.py.
DATABASE_URL=
# JSON list of allowed browser origins
CORS_ORIGINS=
# Session cookie: name, lifetime in hours, and whether it's Secure (keep true outside tests)
SESSION_COOKIE_NAME=
SESSION_TTL_HOURS=
COOKIE_SECURE=
# true: seed demo accounts and offer the one-click demo login (public demo only)
DEMO_MODE=
